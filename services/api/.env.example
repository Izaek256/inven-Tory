# INVENTORY Tory — API Service Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://invtory:changeme@localhost:5432/invtory

# ─── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ─── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Sync ──────────────────────────────────────────────────────────────────────
SYNC_BATCH_SIZE=100
SYNC_RETRY_MAX=5
SYNC_RETRY_BACKOFF_BASE_SECONDS=2
