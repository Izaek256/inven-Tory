# INVENTORY Tory — Desktop App Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ─── API ───────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─── App ───────────────────────────────────────────────────────────────────────
VITE_APP_VERSION=1.1.0

# ─── Tauri ─────────────────────────────────────────────────────────────────────
# Device identity — set by the installer or first-run wizard (Issue 08)
# TAURI_DEVICE_ID=DEVICE-xxxx

# ─── Dev override ──────────────────────────────────────────────────────────────
# DEV-ONLY: fallback device ID used when no device is registered in Tauri's
# secure store. Matches the DEV-DESKTOP-DEVICE seeded by
# infra/seed/dev_only/seed_central_postgres.py.
# Remove or leave blank in production builds.
# VITE_DEV_DEVICE_ID=DEV-DESKTOP-DEVICE
