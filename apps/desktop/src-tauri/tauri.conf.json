{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "invenTory",
  "version": "1.1.6",
  "identifier": "com.invenTory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "invenTory",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Offline-first inventory management system",
    "longDescription": "invenTory is an offline-first inventory management system for managing products, stock movements, transfers, returns, adjustments, and multiple stores.",
    "homepage": "https://github.com/Izaek256/inven-Tory",
    "publisher": "Phantom Technologies",
    "copyright": "Copyright © 2026 Phantom Technologies",
    "license": "MIT",
    "licenseFile": "../../../LICENSE"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Izaek256/inven-Tory/releases/latest/download/latest-windows-x86_64.json",
        "https://github.com/Izaek256/inven-Tory/releases/latest/download/latest-linux-x86_64.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NjQwMDRGQTc4NEM1ClJXVEZoS2RQQUdUWUFIWWVIU01BU21hTCtoSUY1eHo5RlhCZzRQcVEySy8vZWNYTEhJOHlQZDFtCg=="

    }
  }
}
