# INVENTORY Tory — Shared Environment Variables Example
# Copy this file to .env and fill in real values. Never commit .env.

# ─── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (central — used by services/api)
DATABASE_URL=postgresql+asyncpg://invtory:changeme@localhost:5432/invtory

# ─── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Sync ──────────────────────────────────────────────────────────────────────
SYNC_BATCH_SIZE=100
SYNC_RETRY_MAX=5
SYNC_RETRY_BACKOFF_BASE_SECONDS=2

# ─── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
