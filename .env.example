# INVENTORY Tory — Shared Environment Variables Example
# Copy this file to .env and fill in real values. Never commit .env.

# ─── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (central — used by services/api)
# Note: if the password contains special chars (e.g. @), percent-encode them (%40 for @)
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/inventory

# ─── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:1420,http://127.0.0.1:1420,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost

# ─── Sync ──────────────────────────────────────────────────────────────────────
SYNC_BATCH_SIZE=100
SYNC_RETRY_MAX=5
SYNC_RETRY_BACKOFF_BASE_SECONDS=2

# ─── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Web Dashboard ─────────────────────────────────────────────────────────────
VITE_WEB_DEVICE_ID=WEB-DASHBOARD-DEVICE
